datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum IndicadorIE {
  CONTRIBUINTE     // 1 no Bling / SEFAZ
  ISENTO           // 2 no Bling / SEFAZ
  NAO_CONTRIBUINTE // 9 no Bling / SEFAZ
}

enum TipoEndereco {
  ENTREGA
  FISCAL
  AMBOS
}

enum TipoFaturamento {
  PF
  PJ
}

model User {
  id               Int       @id @default(autoincrement())
  nome             String
  sobrenome        String
  cpf              String    @unique
  email            String    @unique
  telefone         String
  senhaHash        String
  dataNascimento   DateTime?
  sexo             String?
  receberNovidades Boolean   @default(false)

  // ID do contato PF sincronizado no Bling (opcional)
  blingContatoId   BigInt?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relações
  empresa          Empresa?
  enderecos        Endereco[]
  pedidos          Pedido[]
  carrinho         Carrinho?

  @@map("users")
}

model Empresa {
  id                String      @id @default(uuid())
  userId            Int         @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  cnpj              String      @unique
  razaoSocial       String
  nomeFantasia      String?
  indicadorIE       IndicadorIE @default(NAO_CONTRIBUINTE)
  inscricaoEstadual String?

  // Endereço fiscal opcional vinculado à empresa (para NF-e no Bling)
  enderecoFiscalId  String?
  enderecoFiscal    Endereco?   @relation("EmpresaEnderecoFiscal", fields: [enderecoFiscalId], references: [id], onDelete: SetNull)

  // ID do contato PJ sincronizado no Bling (opcional)
  blingContatoId    BigInt?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("empresas")
}

model Admin {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtosCriados     Produto[]             @relation("ProdutoCriado")
  produtosAtualizados Produto[]             @relation("ProdutoAtualizado")
  movimentacoes       MovimentacaoEstoque[]
  logsAtividade       LogAtividade[]

  @@map("admins")
}

model Categoria {
  id        String   @id @default(uuid())
  nome      String   @unique
  slug      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos Produto[]

  @@map("categorias")
}

model Tamanho {
  id        String   @id @default(uuid())
  nome      String   @unique
  slug      String   @unique
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estoques      ProdutoEstoque[]
  itemPedidos   ItemPedido[]
  itensCarrinho ItemCarrinho[]

  @@map("tamanhos")
}

model Cor {
  id        String   @id @default(uuid())
  nome      String   @unique
  slug      String   @unique
  hex       String?  // Código da cor (ex: #ff69b4 para rosa)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imagens       ProdutoImagem[]
  estoques      ProdutoEstoque[]
  itemPedidos   ItemPedido[]
  itensCarrinho ItemCarrinho[]

  @@map("cores")
}

model Produto {
  id               String    @id @default(uuid())
  nome             String    @db.VarChar(100)
  preco            Decimal   @db.Decimal(10, 2)
  descricao        String?   @db.Text
  genero           String    @default("Unissex")
  ativo            Boolean   @default(true)
  categoryId       String
  categoria        Categoria @relation(fields: [categoryId], references: [id])

  // Dados Fiscais para NF-e / Bling
  ncm              String    @default("61112000") @db.VarChar(10) // Ex: 61112000 (Vestuário de malha de algodão para bebês)
  origem           Int       @default(0) // 0 = Nacional

  temOferta        Boolean   @default(false)
  precoPromocional Decimal   @default(0) @db.Decimal(10, 2)

  isVisible        Boolean   @default(true)
  isNovidade       Boolean   @default(false)

  estoques      ProdutoEstoque[]
  imagens       ProdutoImagem[]
  movimentacoes MovimentacaoEstoque[]
  itemPedidos   ItemPedido[]
  itensCarrinho ItemCarrinho[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criadoPorId     Int?
  criadoPor       Admin? @relation("ProdutoCriado", fields: [criadoPorId], references: [id])

  atualizadoPorId Int?
  atualizadoPor   Admin? @relation("ProdutoAtualizado", fields: [atualizadoPorId], references: [id])

  @@map("produtos")
}

model ProdutoEstoque {
  id        String   @id @default(uuid())
  produtoId String
  tamanhoId String?
  corId     String?
  estoque   Int      @default(0)
  ativo     Boolean  @default(true)

  produto Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tamanho Tamanho? @relation(fields: [tamanhoId], references: [id], onDelete: Restrict)
  cor     Cor?     @relation(fields: [corId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([produtoId, tamanhoId, corId])
  @@map("produto_estoques")
}

model ProdutoImagem {
  id        String   @id @default(uuid())
  url       String
  ordem     Int      @default(0)
  produtoId String
  corId     String
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  cor       Cor      @relation(fields: [corId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("produto_imagens")
}

model MotivoEstoque {
  id        String   @id @default(uuid())
  nome      String   @unique
  tipo      String   // 'ENTRADA' ou 'SAIDA'
  ativo     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movimentacoes MovimentacaoEstoque[]

  @@map("motivos_estoque")
}

model MovimentacaoEstoque {
  id         String   @id @default(uuid())
  produtoId  String
  corNome    String
  tamanho    String
  tipo       String   // 'ENTRADA' ou 'SAIDA'
  quantidade Int

  motivoId String
  motivo   MotivoEstoque @relation(fields: [motivoId], references: [id], onDelete: Restrict)

  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id], onDelete: Restrict)

  data DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("movimentacoes_estoque")
}

model LogAtividade {
  id      String   @id @default(uuid())
  adminId Int
  admin   Admin    @relation(fields: [adminId], references: [id])
  acao    String
  data    DateTime @default(now())

  @@map("logs_atividade")
}

// ========================================================
// TABELAS DE PEDIDOS, ENDEREÇO E FRETE
// ========================================================

model Endereco {
  id           String       @id @default(uuid())
  tipo         TipoEndereco @default(ENTREGA)
  principal    Boolean      @default(false)

  cep          String
  rua          String
  numero       String
  complemento  String?
  bairro       String
  cidade       String
  estado       String
  codigoIbge   String?      // Código IBGE de 7 dígitos do município para NF-e / Bling
  destinatario String?      // Nome de quem receberá o pacote ou razão social/nome no endereço

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  pedidosEntrega Pedido[]  @relation("PedidoEntrega")
  pedidosFiscal  Pedido[]  @relation("PedidoFiscal")
  empresasFiscal Empresa[] @relation("EmpresaEnderecoFiscal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("enderecos")
}

enum StatusPedido {
  PENDENTE
  PAGO
  EM_SEPARACAO
  RECUSADO
  CANCELADO
  ENVIADO
  ENTREGUE
}

model Pedido {
  id           String       @id @default(uuid())
  numeroPedido Int          @unique @default(autoincrement()) // Gera sequencialmente ex: 1001, 1002...
  status       StatusPedido @default(PENDENTE)

  // Valores Financeiros
  subtotal   Decimal @db.Decimal(10, 2)
  valorFrete Decimal @default(0.00) @db.Decimal(10, 2)
  valorTotal Decimal @db.Decimal(10, 2)

  // Informações de Frete e Entrega
  servicoFrete   String? // Ex: "Sedex", "Loggi", "Melhor Envio"
  prazoEntrega   String? // Ex: "3 dias úteis"
  codigoRastreio String? // Código de rastreamento para o cliente

  // Dimensões do Pacote (para emissão no Melhor Envio)
  pesoTotal        Float? @default(0.3)  // em Kg (ex: 0.3 = 300g)
  alturaCaixa      Float? @default(8.0)  // em cm
  larguraCaixa     Float? @default(16.0) // em cm
  comprimentoCaixa Float? @default(24.0) // em cm

  // Integração com Mercado Pago
  metodoPagamento String? // Ex: "credit_card", "pix", "ticket"
  mpPaymentId     String? // ID do pagamento retornado pelo Mercado Pago

  // Integração com Bling / NF-e
  blingNfeId      BigInt?
  nfeNumero       String?
  nfeSerie        String?
  chaveAcessoNfe  String?
  nfeStatus       String?   // Ex: PENDENTE, AUTORIZADA, REJEITADA
  nfeLinkDanfe    String?   @db.Text
  nfeLinkXml      String?   @db.Text
  nfeErroMensagem String?   @db.Text

  // Controle de expiração do estoque (15 min para PIX ou 48h úteis para Cartão)
  expiraEm         DateTime?

  // Snapshot do Cliente / Destinatário no momento do pedido
  tipoFaturamento          TipoFaturamento @default(PF)
  clienteNome              String          // Nome completo (PF) ou Razão Social (PJ)
  clienteNomeFantasia      String?         // Preenchido quando PJ
  clienteEmail             String
  clienteCpf               String          // CPF do comprador (PF) ou CNPJ (PJ)
  clienteIndicadorIE       IndicadorIE?    // Usado para NF-e no Bling
  clienteInscricaoEstadual String?         // Preenchido quando PJ contribuinte
  clienteFone              String?

  // Relação opcional com o cadastro de User
  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Endereço de Entrega do Pedido
  enderecoId String
  endereco   Endereco @relation("PedidoEntrega", fields: [enderecoId], references: [id], onDelete: Restrict)

  // Endereço Fiscal opcional (quando diferente do endereço de entrega, ex: "Usar outro endereço para a nota fiscal" ou PJ)
  enderecoFiscalId String?
  enderecoFiscal   Endereco? @relation("PedidoFiscal", fields: [enderecoFiscalId], references: [id], onDelete: SetNull)

  itens ItemPedido[]
  
  // Histórico de status do pedido
  historicoStatus HistoricoStatusPedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pedidos")
}

model HistoricoStatusPedido {
  id         String       @id @default(uuid())
  pedidoId   String
  pedido     Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  status     StatusPedido
  data       DateTime     @default(now())
  observacao String?

  @@map("historico_status_pedido")
}

model ItemPedido {
  id String @id @default(uuid())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  tamanhoId String?
  tamanho   Tamanho? @relation(fields: [tamanhoId], references: [id], onDelete: SetNull)

  corId String?
  cor   Cor? @relation(fields: [corId], references: [id], onDelete: SetNull)

  // Snapshot do produto no momento da compra
  nomeProduto   String
  precoUnitario Decimal @db.Decimal(10, 2)
  quantidade    Int

  createdAt DateTime @default(now())

  @@map("itens_pedido")
}

// ========================================================
// TABELAS DO CARRINHO DE COMPRAS
// ========================================================

model Carrinho {
  id        String         @id @default(uuid())
  userId    Int            @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itens     ItemCarrinho[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("carrinhos")
}

model ItemCarrinho {
  id         String   @id @default(uuid())
  carrinhoId String
  carrinho   Carrinho @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)

  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  tamanhoId  String?
  tamanho    Tamanho? @relation(fields: [tamanhoId], references: [id], onDelete: SetNull)

  corId      String?
  cor        Cor?     @relation(fields: [corId], references: [id], onDelete: SetNull)

  quantidade Int      @default(1)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Evita duplicar o mesmo produto com a mesma combinação de tamanho e cor no carrinho
  @@unique([carrinhoId, produtoId, tamanhoId, corId])
  @@map("itens_carrinho")
}

model Cupom {
  id               String    @id @default(uuid())
  codigo           String    @unique // Ex: PRIMEIRACOMPRA ou VERAO2026
  tipo             String    // 'PERCENTUAL' ou 'FIXO'
  valor            Decimal   @db.Decimal(10, 2) // Ex: 10.00 (%) ou 50.00 (R$)
  isPrimeiraCompra Boolean   @default(false) @map("is_primeira_compra")
  dataValidade     DateTime? @map("data_validade") // Opcional (para campanhas sazonais)
  ativo            Boolean   @default(true)
  criadoEm         DateTime  @default(now()) @map("criado_em")
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em")

  @@map("cupons")
}

// ========================================================
// INTEGRAÇÃO OAUTH 2.0 - BLING ERP
// ========================================================

model BlingToken {
  id           Int      @id @default(1)
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  @@map("bling_tokens")
}